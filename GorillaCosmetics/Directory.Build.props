<Project>
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GamePath>
    <GameAssemblyPath Condition="'$(GameAssemblyPath)' == ''">$(GamePath)\Gorilla Tag_Data\Managed</GameAssemblyPath>
    <BepInExAssemblyPath Condition="'$(BepInExAssemblyPath)' == ''">$(GamePath)\BepInEx\core</BepInExAssemblyPath>
    <PluginsPath Condition="'$(PluginsPath)' == ''">$(GamePath)\BepInEx\plugins</PluginsPath>
  </PropertyGroup>
</Project>
